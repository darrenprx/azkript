<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<FinalDraft DocumentType="Script" Template="No" Version="6">
  <DocumentRef id="2f8e0f9c-2b1d-4a58-8df6-2f6f0f2a8d11"/>
  <Content>
    <Paragraph Type="Scene Heading" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b01">
      <SceneProperties Length="1/8" Page="1" Title="ROOFTOP - DUSK"/>
      <Text>EXT. ROOFTOP - DUSK</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b02">
      <Text>Wind pulls at a line of antennae. A radio lies on the gravel, its dial glowing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b03">
      <Text>MARA</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b04">
      <Text>(into the radio)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b05">
      <Text>This is Mara. If anyone can hear me, say something </Text>
      <Text Style="Italic">now</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b06">
      <Text>Static. Then, under it, a voice:</Text>
    </Paragraph>
    <Paragraph Type="DualDialogue" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b07">
      <DualDialogue>
        <Paragraph Type="Character">
          <Text>MARA</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Who is this?</Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>VOICE</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Someone who has been waiting.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Transition" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b08">
      <Text>CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b09">
      <SceneProperties Length="1/8" Page="1" Title="STATION - NIGHT"/>
      <Text>INT. RADIO STATION - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8d1f6a24-7d4d-4d8e-9a4b-3d2f5c6a1b0a">
      <Text>Rows of dead monitors. One screen wakes and paints the room blue.</Text>
    </Paragraph>
  </Content>
